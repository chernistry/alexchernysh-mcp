[
  {
    "name": "ask_alex",
    "title": "Ask Alex",
    "description": "Ask a question about Alex Chernysh — background, projects, Bernstein, or working style. The answer is grounded in the published site content and declines questions it has no source for.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000,
          "description": "A question about Alex Chernysh: background, projects, Bernstein, or working style."
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "answer",
        "sources"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
